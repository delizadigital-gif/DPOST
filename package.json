{
  "name": "dpost",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dpost/web --filter @dpost/worker dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @dpost/web test:e2e",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:migrate": "pnpm --filter @dpost/db migrate:dev",
    "db:deploy": "pnpm --filter @dpost/db migrate:deploy",
    "db:seed": "pnpm --filter @dpost/db seed",
    "db:studio": "pnpm --filter @dpost/db studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "railway": "^3.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
