# DPOST environment template.
# Copy to `.env` in the repo root for local development: the web app, the
# worker and Prisma all read that single file. Never commit `.env`. In
# staging and production, set these in the hosting provider's dashboard.
#
# Every variable is validated at startup by packages/config/src/env.ts.
# New variables are added here phase by phase.

# ── App ──────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ── Database & Redis (values match docker-compose.yml) ──
DATABASE_URL=postgresql://dpost:dpost@localhost:5432/dpost
REDIS_URL=redis://localhost:6379/0

# ── Authentication (web app only) ────────────────────
# Signs session cookies. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Optional "Continue with Google": create an OAuth client in Google Cloud Console,
# redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email ────────────────────────────────────────────
# Local: Mailpit from docker-compose (inbox at http://localhost:8025).
# Production: Resend over SMTP. Railway blocks ports 465/587, so use Resend’s
# alternative port: smtps://resend:<RESEND_API_KEY>@smtp.resend.com:2465
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="DPOST <no-reply@dpost.local>"
# Public contact address shown on the Privacy, Terms and Data deletion pages.
CONTACT_EMAIL=

# ── Encryption of stored social-media tokens (required from Phase 8) ──
# Versioned keys, `<version>:<32 random bytes, base64>`, comma-separated.
# Generate a key:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To rotate: add `2:<new key>`, set the version to 2, keep version 1 until
# every stored token has been re-encrypted.
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_KEY_VERSION=

# ── Observability (optional) ─────────────────────────
SENTRY_DSN=

# ── AI (Phase 6) ─────────────────────────────────────
# Anthropic API key, from https://console.anthropic.com → API keys.
# Billed per token by Anthropic; leave it empty and DPOST simply switches the
# "Write with AI" features off rather than failing mid-request.
ANTHROPIC_API_KEY=
# Role-based model slots: features ask for "smart" or "fast", never a model
# name, so a model change is an environment change.
LLM_MODEL_SMART=claude-sonnet-5
LLM_MODEL_FAST=claude-haiku-4-5-20251001
# `stub` swaps in a deterministic fake for tests and for running without a
# key. Everything it produces is labelled as a stub in the interface, and the
# environment schema refuses it in production.
AI_PROVIDER=anthropic

# ── Facebook publishing (Phase 8) ────────────────────
# From developers.facebook.com → your app → Settings → Basic.
# Leave empty and DPOST runs as before: the Channels screen says connecting
# is not set up rather than failing inside an OAuth redirect.
META_APP_ID=
META_APP_SECRET=
# The Graph API version every request is pinned to. Meta ships a new one
# roughly quarterly and retires old ones after about two years — check their
# changelog before changing this, because field names move between versions.
META_GRAPH_VERSION=v23.0
# Optional: a Facebook Login for Business configuration id.
META_LOGIN_CONFIG_ID=
# A random string you choose, if you set up Page webhooks later.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
META_WEBHOOK_VERIFY_TOKEN=
